// ============================================================================
// DB_MqttConfig  –  Global Data Block: MQTT broker settings and tag list
// ============================================================================
// Target  : Siemens S7-1200, TIA Portal V17 or newer.
// Library : Siemens LMQTT_Client (add via Options → Manage general libraries).
//
// STEP-BY-STEP: How to add this block in TIA Portal
// --------------------------------------------------
// 1. In the Project tree, expand your CPU and open "Program blocks".
// 2. Click "Add new block" → choose "Data block" → type: Global DB.
// 3. Name it "DB_MqttConfig".  Keep "Optimized block access" enabled.
// 4. Right-click the DB → "Generate blocks from source" and import this file,
//    OR copy the declarations below into the SCL editor manually.
// 5. Set brokerIp to the IP address of the machine running Mosquitto/Docker.
// 6. Set unixEpochOffset (see explanation below).
// 7. Compile and download to the PLC.
//
// unixEpochOffset – How to set the correct Unix timestamp
// -------------------------------------------------------
// GET_LTIME() returns nanoseconds elapsed since the PLC last powered on,
// not a calendar timestamp.  To produce proper Unix epoch values:
//   a) Note the current Unix timestamp (e.g. from https://www.unixtimestamp.com).
//   b) Note the PLC uptime shown in the Online & diagnostics view.
//   c) unixEpochOffset = current_unix_timestamp − PLC_uptime_seconds
//
// Example: Unix time = 1 710 000 000, PLC has been running 120 s
//          → unixEpochOffset := 1709999880.0
//
// Leave unixEpochOffset := 0.0 during initial testing; the backend will
// still receive valid data — only the wall-clock timestamp will be offset
// from actual calendar time.
// ============================================================================

DATA_BLOCK "DB_MqttConfig"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0

STRUCT

    // ── Broker connection ─────────────────────────────────────────────────────
    brokerIp        : STRING[15] := '192.168.1.100'; // ← CHANGE: IP of Mosquitto host
    brokerPort      : UINT       := 1883;           // default Mosquitto/MQTT port
    clientId        : STRING[30] := 'S7-1200-PLC'; // unique ID on the broker
    keepAlive       : UINT       := 60;            // MQTT keep-alive in seconds

    // ── Unix timestamp calibration ────────────────────────────────────────────
    // Set this to (current_unix_time − PLC_uptime_seconds) before first run.
    // See the header comment above for the calculation.
    unixEpochOffset : LREAL := 0.0;

    // ── Runtime state (managed by FB_MqttTagPublisher) ───────────────────────
    mqttHandle : UDINT := 0;     // connection handle returned by MQTT_Connect
    connected  : BOOL  := FALSE; // TRUE while broker session is alive

    // ── Tag table ─────────────────────────────────────────────────────────────
    // tagCount must match the number of populated tags[] entries.
    tagCount : INT := 21;

    tags : ARRAY[1..21] OF STRUCT
        name : STRING[80];  // tag identifier published to MQTT, e.g. 'pump1/pressure'
        unit : STRING[20];  // engineering unit,                  e.g. 'bar'
    END_STRUCT;

END_STRUCT

BEGIN
    brokerIp        := '192.168.1.100'; // ← CHANGE to your broker IP
    brokerPort      := 1883;
    clientId        := 'S7-1200-PLC';
    keepAlive       := 60;
    unixEpochOffset := 0.0;            // ← CHANGE: see header for calculation
    tagCount        := 21;

    // ── Pump 1 ────────────────────────────────────────────────────────────────
    tags[1].name  := 'pump1/flow';         tags[1].unit  := 'm3/h';
    tags[2].name  := 'pump1/pressure';     tags[2].unit  := 'bar';
    tags[3].name  := 'pump1/temperature';  tags[3].unit  := 'C';
    tags[4].name  := 'pump1/current';      tags[4].unit  := 'A';
    tags[5].name  := 'pump1/vibration';    tags[5].unit  := 'mm/s';

    // ── Pump 2 ────────────────────────────────────────────────────────────────
    tags[6].name  := 'pump2/flow';         tags[6].unit  := 'm3/h';
    tags[7].name  := 'pump2/pressure';     tags[7].unit  := 'bar';
    tags[8].name  := 'pump2/temperature';  tags[8].unit  := 'C';
    tags[9].name  := 'pump2/current';      tags[9].unit  := 'A';
    tags[10].name := 'pump2/vibration';    tags[10].unit := 'mm/s';

    // ── Tanks ─────────────────────────────────────────────────────────────────
    tags[11].name := 'tank1/level';        tags[11].unit := '%';
    tags[12].name := 'tank2/level';        tags[12].unit := '%';

    // ── Compressor ────────────────────────────────────────────────────────────
    tags[13].name := 'compressor/pressure';    tags[13].unit := 'bar';
    tags[14].name := 'compressor/temperature'; tags[14].unit := 'C';

    // ── Heat exchanger ────────────────────────────────────────────────────────
    tags[15].name := 'heat_exchanger/inlet_temp';  tags[15].unit := 'C';
    tags[16].name := 'heat_exchanger/outlet_temp'; tags[16].unit := 'C';

    // ── Conveyor ──────────────────────────────────────────────────────────────
    tags[17].name := 'conveyor/speed';   tags[17].unit := 'm/min';
    tags[18].name := 'conveyor/current'; tags[18].unit := 'A';

    // ── Boiler ────────────────────────────────────────────────────────────────
    tags[19].name := 'boiler/pressure';    tags[19].unit := 'bar';
    tags[20].name := 'boiler/temperature'; tags[20].unit := 'C';
    tags[21].name := 'boiler/flow';        tags[21].unit := 'm3/h';

END_DATA_BLOCK
