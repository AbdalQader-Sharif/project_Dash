// ============================================================================
// DB_MqttConfig  –  Global Data Block: MQTT broker settings & tag list
// ============================================================================
// Purpose:
//   Centralises all MQTT connection parameters and the per-tag metadata that
//   FB_MqttTagPublisher needs.  Edit this DB in TIA Portal to match your
//   actual broker address and PLC sensor layout.
//
// ⚠️  IMPORTANT – Before downloading to the PLC, update the following fields:
//   • brokerIp   → IP address of the machine running Docker / Mosquitto
//   • clientId   → any unique string to identify this PLC on the broker
//
// How to add this block to TIA Portal:
//   1. In the project tree, right-click "Program blocks" → Add new block.
//   2. Select "Data block", name it "DB_MqttConfig", type = Global DB.
//   3. Copy-paste the variable declarations below into the SCL editor
//      (or switch to the data view and add the variables manually).
//   4. Uncheck "Optimized block access" in the DB Properties so that the
//      python-snap7 connector (Approach A) can read it if needed.
// ============================================================================

DATA_BLOCK "DB_MqttConfig"
{ S7_Optimized_Access := 'FALSE' }  // non-optimized for PUT/GET compatibility
VERSION : 0.1

STRUCT
    // ── Broker connection ─────────────────────────────────────────────────────
    // ⚠️  Update brokerIp to the IP of the host running Docker before download.
    // The default '0.0.0.0' is intentionally invalid — the FB will not connect
    // until you replace it with your actual Docker host IP address.
    brokerIp   : STRING[15] := '0.0.0.0';      // ← CHANGE to your Docker host IP
    brokerPort : UINT       := 1883;            // default Mosquitto port
    clientId   : STRING[30] := 'S7-1200-PLC';  // unique client identifier
    keepAlive  : UINT       := 60;             // MQTT keep-alive in seconds

    // ── Runtime state (written by FB_MqttTagPublisher) ────────────────────────
    mqttHandle : UDINT      := 0;              // connection handle from MQTT_Connect
    connected  : BOOL       := FALSE;          // TRUE when broker connection is up

    // ── Tag table ─────────────────────────────────────────────────────────────
    // Each entry maps one physical sensor to its MQTT topic metadata.
    // tagCount must match the number of populated entries.
    tagCount   : INT := 21;

    tags : ARRAY[1..21] OF STRUCT
        name    : STRING[80];  // tag identifier   e.g. 'pump1/pressure'
        unit    : STRING[20];  // engineering unit  e.g. 'bar'
    END_STRUCT;

END_STRUCT

BEGIN
    // ── Broker connection ─────────────────────────────────────────────────────
    // ⚠️  Update brokerIp to the IP of the host running Docker before download.
    brokerIp   := '0.0.0.0';      // ← CHANGE to your Docker host IP
    brokerPort := 1883;
    clientId   := 'S7-1200-PLC';
    keepAlive  := 60;

    tagCount := 21;

    // ── Pump 1 ────────────────────────────────────────────────────────────────
    tags[1].name  := 'pump1/flow';         tags[1].unit  := 'm3/h';
    tags[2].name  := 'pump1/pressure';     tags[2].unit  := 'bar';
    tags[3].name  := 'pump1/temperature';  tags[3].unit  := 'C';
    tags[4].name  := 'pump1/current';      tags[4].unit  := 'A';
    tags[5].name  := 'pump1/vibration';    tags[5].unit  := 'mm/s';

    // ── Pump 2 ────────────────────────────────────────────────────────────────
    tags[6].name  := 'pump2/flow';         tags[6].unit  := 'm3/h';
    tags[7].name  := 'pump2/pressure';     tags[7].unit  := 'bar';
    tags[8].name  := 'pump2/temperature';  tags[8].unit  := 'C';
    tags[9].name  := 'pump2/current';      tags[9].unit  := 'A';
    tags[10].name := 'pump2/vibration';    tags[10].unit := 'mm/s';

    // ── Tanks ─────────────────────────────────────────────────────────────────
    tags[11].name := 'tank1/level';        tags[11].unit := '%';
    tags[12].name := 'tank2/level';        tags[12].unit := '%';

    // ── Compressor ───────────────────────────────────────────────────────────
    tags[13].name := 'compressor/pressure';     tags[13].unit := 'bar';
    tags[14].name := 'compressor/temperature';  tags[14].unit := 'C';

    // ── Heat exchanger ────────────────────────────────────────────────────────
    tags[15].name := 'heat_exchanger/inlet_temp';   tags[15].unit := 'C';
    tags[16].name := 'heat_exchanger/outlet_temp';  tags[16].unit := 'C';

    // ── Conveyor ──────────────────────────────────────────────────────────────
    tags[17].name := 'conveyor/speed';    tags[17].unit := 'm/min';
    tags[18].name := 'conveyor/current';  tags[18].unit := 'A';

    // ── Boiler ────────────────────────────────────────────────────────────────
    tags[19].name := 'boiler/pressure';     tags[19].unit := 'bar';
    tags[20].name := 'boiler/temperature';  tags[20].unit := 'C';
    tags[21].name := 'boiler/flow';         tags[21].unit := 'm3/h';
END_DATA_BLOCK
